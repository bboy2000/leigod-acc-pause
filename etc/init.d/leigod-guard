#!/bin/sh /etc/rc.common
# leigod-guard 开机自启服务

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/bin/leigod-guard.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	/bin/sh /usr/bin/leigod-guard.sh cleanup
}

restart() {
	stop
	start
}
