  --lg-text:#1f2933;    --lg-text-2:#616e7c;
  --lg-border:#e4e7eb;  --lg-bg:#f0f2f5; --lg-card:#ffffff;
  --lg-term-bg:#1e2430; --lg-term-text:#c9d4e3;
  --lg-radius:12px; --lg-pill:20px;
  --lg-shadow:0 1px 3px rgba(16,24,40,.10);
}
@media (prefers-color-scheme: dark){
  :root{
    --lg-bg:#121826; --lg-card:#1a2233; --lg-border:#2a3548;
    --lg-text:#e6ebf2; --lg-text-2:#9aa8bb;
    --lg-primary:#66bb6a; --lg-primary-soft:#1f3a24;
    --lg-danger:#ef7b7b;  --lg-danger-soft:#3d1a1a;
    --lg-info:#64a5f0;    --lg-info-soft:#182c45;
  }
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--lg-bg);color:var(--lg-text);font-family:system-ui,"Segoe UI","Microsoft YaHei",sans-serif;padding:24px 16px;}
.wrap{max-width:760px;margin:0 auto;}
.card{background:var(--lg-card);border:1px solid var(--lg-border);border-radius:var(--lg-radius);box-shadow:var(--lg-shadow);padding:14px 16px;margin-bottom:12px;}
.head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:16px;}
.head .t{font-size:18px;font-weight:700;}
.btns{display:flex;gap:8px;}
.btn{border:none;border-radius:8px;padding:7px 18px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}
.btn-start{background:var(--lg-primary);color:#fff;}
.btn-stop{background:transparent;color:var(--lg-danger);border:1px solid var(--lg-danger);}
.btn-restart{background:var(--lg-info-soft);color:var(--lg-info);border:1px solid var(--lg-border);}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.kpi-label{font-size:12px;color:var(--lg-text-2);margin-bottom:10px;}
.pill{display:inline-block;border-radius:var(--lg-pill);padding:4px 16px;font-size:13px;font-weight:700;}
.pill-ok{background:var(--lg-primary-soft);color:var(--lg-primary);}
.pill-bad{background:var(--lg-danger-soft);color:var(--lg-danger);}
.hero{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;}
.hero-label{font-size:12px;color:var(--lg-text-2);margin-bottom:6px;}
.num{font-family:Consolas,"JetBrains Mono",monospace;font-size:52px;font-weight:700;letter-spacing:2px;line-height:1;color:var(--lg-primary);}
.num.warn{color:#e65100;animation:pulse 1s ease-in-out infinite;}
.num.bad{color:var(--lg-danger);font-size:38px;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.55;}}
.bar{height:8px;background:var(--lg-border);border-radius:4px;overflow:hidden;margin-top:10px;}
.bar i{display:block;height:100%;border-radius:4px;}
.meta{font-size:12px;color:var(--lg-text-2);margin-top:8px;}
.hero-side{flex:1;min-width:220px;background:var(--lg-primary-soft);border-radius:10px;padding:12px 16px;font-size:12px;line-height:2;color:var(--lg-text);}
.bill-btn{display:inline-block;border:none;border-radius:8px;padding:8px 22px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;margin-top:12px;}
.bill-start{background:var(--lg-primary);color:#fff;}
.bill-stop{background:transparent;color:var(--lg-danger);border:1px solid var(--lg-danger);}
.bill-note{font-size:11px;color:var(--lg-text-2);margin-top:6px;}
.tbl{width:100%;border-collapse:separate;border-spacing:0;}
.tbl th{background:var(--lg-info);color:#fff;font-size:13px;padding:9px 0;font-weight:600;text-align:center;}
.tbl th:first-child{border-radius:8px 0 0 8px;}
.tbl th:last-child{border-radius:0 8px 8px 0;}
.tbl td{text-align:center;padding:9px 0;font-size:13px;color:var(--lg-text);border-bottom:1px solid var(--lg-border);font-family:Consolas,monospace;}
.tbl tr:last-child td{border-bottom:none;}
.note{text-align:center;font-size:12px;color:var(--lg-text-2);margin-top:10px;}
.term{background:var(--lg-term-bg);border-radius:10px;padding:14px 16px;font-family:Consolas,monospace;font-size:12px;line-height:1.9;color:var(--lg-term-text);overflow-x:auto;}
.term .t{color:#7d8aa0;}
.term .ok{color:#7cc47f;}
.term .err{color:#ef7b7b;}
@media (max-width:640px){
  .kpis{grid-template-columns:1fr 1fr;}
  .num{font-size:38px;}
  .head .t{font-size:15px;}
}
</style>
</head>
<body>
<div class="wrap">
	<div class="head">
		<div class="t">雷神加速器 · 运行状态</div>
		<div class="btns">
			<form style="display:inline;margin:0;" method="post"><input type="hidden" name="act" value="start"><button type="submit" class="btn btn-start">启动</button></form>
			<form style="display:inline;margin:0;" method="post"><input type="hidden" name="act" value="stop"><button type="submit" class="btn btn-stop">停止</button></form>
			<form style="display:inline;margin:0;" method="post"><input type="hidden" name="act" value="restart"><button type="submit" class="btn btn-restart">重启</button></form>
		</div>
	</div>
	<div id="lg-dynamic">
	<div class="kpis">
		<div class="card"><div class="kpi-label">守护进程</div><span class="pill ]==] .. (alive and [[pill-ok">运行中]] or [[pill-bad">未运行]]) .. [==[</span></div>
		<div class="card"><div class="kpi-label">插件监控 (monitor_running)</div><span class="pill ]==] .. (mr == "true" and [[pill-ok">正常]] or [[pill-bad">异常]]) .. [==[</span></div>
		<div class="card"><div class="kpi-label">计时状态</div><span class="pill ]==] .. (sd_bad and [[pill-bad">]] .. esc(sd_txt) or [[pill-ok">]] .. esc(sd_txt)) .. [==[</span></div>
	</div>
	<div class="card hero">
		<div style="flex:1;min-width:260px;">
]==]

if not alive then
	H[#H+1] = '<div class="hero-label">守护进程状态</div><div class="num bad">守护未运行</div><div class="meta">请检查 /etc/init.d/leigod-guard 服务状态</div>'
elseif billing_paused then
	H[#H+1] = '<div class="hero-label">计费状态</div><div class="num bad">计费已暂停</div><div class="meta">设备活动后' .. (auto_resume == 1 and "自动恢复计费" or "需手动恢复或在雷神 App 操作") .. '</div>'
	H[#H+1] = '<form style="margin:0;" method="post"><input type="hidden" name="act" value="billresume"><button type="submit" class="bill-btn bill-start">▶ 开始计费</button></form><div class="bill-note">注意：无游戏流量时守护会在约 1 分钟内自动重新暂停</div>'
elseif cloud_pid == "0" and gstate == "paused" then
	H[#H+1] = '<div class="hero-label">计费状态</div><div class="num">计费中</div><div class="meta">云端已恢复计费（App 手动操作），守护正在同步状态</div>'
	H[#H+1] = '<form style="margin:0;" method="post"><input type="hidden" name="act" value="billpause"><button type="submit" class="bill-btn bill-stop">⏸ 暂停计费</button></form>'
elseif gstate == "active" then
	H[#H+1] = '<div class="hero-label">实时状态</div><div class="num">设备活动中</div><div class="meta">检测到游戏流量，空闲计时已重置</div>'
	H[#H+1] = '<form style="margin:0;" method="post"><input type="hidden" name="act" value="billpause"><button type="submit" class="bill-btn bill-stop">⏸ 暂停计费</button></form><div class="bill-note">立即暂停计费，不影响游戏加速通道</div>'
else
	local numcls = (remaining <= 30) and "num warn" or "num"
	local barbg = (remaining <= 30) and "background:#e65100;" or "background:linear-gradient(90deg,var(--lg-primary),#66bb6a);"
	H[#H+1] = '<div class="hero-label">距自动暂停倒计时（每 10 秒自动刷新）</div><div class="' .. numcls .. '">' .. fmt(remaining) .. '</div>'
	H[#H+1] = '<div class="bar"><i style="width:' .. pct .. '%;' .. barbg .. '"></i></div>'
	H[#H+1] = '<div class="meta">空闲 ' .. fmt(max_idle) .. ' / 阈值 ' .. idle_min .. ':00 ・ 监控设备 ' .. #devs .. ' 台</div>'
	H[#H+1] = '<form style="margin:0;" method="post"><input type="hidden" name="act" value="billpause"><button type="submit" class="bill-btn bill-stop">⏸ 暂停计费</button></form><div class="bill-note">立即暂停计费，无需等待空闲倒计时</div>'
end

H[#H+1] = '</div><div class="hero-side">'
if billing_paused then
	H[#H+1] = '当前无计费消耗<br>暂停期间<b>不消耗时长</b><br>监控仍在后台运行'
else
	H[#H+1] = '监控设备 <b>' .. #devs .. '</b> 台<br>采样间隔 30 秒<br>活跃判定 100KB/采样<br>空闲达阈值<b>自动暂停计费</b>'
end
H[#H+1] = '</div></div>'

H[#H+1] = '<div class="card"><div class="kpi-label" style="margin-bottom:8px;">游戏设备监控</div>'
if #rows > 0 then
	H[#H+1] = '<table class="tbl"><tr><th>游戏设备</th><th>最近活动</th><th>已空闲</th><th>距自动暂停</th></tr>'
	for _, r in ipairs(rows) do
		H[#H+1] = "<tr><td>" .. esc(r[1]) .. "</td><td>" .. r[2] .. "</td><td>" .. r[3] .. "</td><td>" .. esc(r[4]) .. "</td></tr>"
	end
	H[#H+1] = "</table>"
else
	H[#H+1] = '<div class="note">尚未配置监控设备，请到 LuCI「无人值守」页面添加游戏设备 IP</div>'
end
H[#H+1] = '<div class="note">空闲暂停阈值：' .. idle_min .. ' 分钟（可在 LuCI「无人值守」页面调整）</div></div>'

H[#H+1] = '</div><div class="card"><div class="kpi-label" style="margin-bottom:8px;">守护日志（最近 10 条）</div>'
if #loglines > 0 then
	H[#H+1] = '<div class="term">' .. table.concat(loglines, "<br>") .. '</div>'
else
	H[#H+1] = '<div class="note">暂无日志</div>'
end
H[#H+1] = [==[</div>
</div>
<script>
setInterval(function(){
	var box = document.getElementById("lg-dynamic");
	if(!box) return;
	fetch(location.href, {credentials:"same-origin"}).then(function(r){return r.text();}).then(function(t){
		var d = new DOMParser().parseFromString(t, "text/html");
		var nd = d.getElementById("lg-dynamic");
		if(nd){ box.innerHTML = nd.innerHTML; }
	}).catch(function(){});
}, 10000);
</script>
</body>
</html>]==]

io.write(table.concat(H, "\n"))
