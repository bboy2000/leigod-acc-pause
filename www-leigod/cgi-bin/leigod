#!/usr/bin/lua
--[[
  雷神加速器 独立状态页 CGI (脱离 QWRT LuCI 框架)
  由 uhttpd 第二实例(默认 8081 端口)以 CGI 方式运行
  数据与 LuCI 版运行状态页完全一致: KPI/倒计时Hero/计费开关/设备表/日志
--]]

local function esc(s)
	return tostring(s or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
end

local function sh(c)
	local f = io.popen(c .. " 2>/dev/null")
	local o = f and f:read("*a") or ""
	if f then f:close() end
	return o or ""
end

local function uci_get(k)
	local v = sh("uci -q get leigod-guard.config." .. k)
	return (v:gsub("%s+", ""))
end

-- ===== POST 动作处理 =====
if (os.getenv("REQUEST_METHOD") or "") == "POST" then
	local len = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
	if len > 0 and len < 1024 then
		local body = io.read(len) or ""
		local act = body:match("act=([a-z]+)")
		if act == "start" or act == "stop" or act == "restart" then
			os.execute("ubus call leigod " .. act .. " >/dev/null 2>&1 &")
		elseif act == "billpause" or act == "billresume" then
			local token = uci_get("token")
			if token ~= "" then
				local api = (act == "billresume") and "/api/user/recover" or "/api/user/pause"
				os.execute("curl -s -m 8 -A 'Mozilla/5.0' -H 'Origin: https://www.leigod.com' -H 'Referer: https://www.leigod.com/' -H 'Content-Type: application/json' --data '{\"account_token\":\"" .. token .. "\"}' 'https://webapi.leigod.com" .. api .. "?os_type=4&region_code=1&src_channel=guanwang&lang=zh_CN' >/dev/null 2>&1 &")
			end
		end
	end
	io.write("Status: 303 See Other\r\nLocation: /cgi-bin/leigod\r\n\r\n")
	return
end

io.write("Content-Type: text/html; charset=utf-8\r\n\r\n")

-- ===== 数据采集 =====
local idle_min = tonumber(uci_get("idle_minutes") or "15") or 15
local auto_resume = tonumber(uci_get("auto_resume") or "0") or 0
local token = uci_get("token")

local alive = os.execute("pgrep -f leigod-guard.sh >/dev/null 2>&1") == 0
local mr = sh("ubus call leigod get_status 2>/dev/null | jsonfilter -e '@.monitor_running'")
mr = mr:gsub("%s+", "")
local statefile = io.open("/tmp/leigod-guard/state", "r")
local gstate = statefile and statefile:read("*l") or ""
if statefile then statefile:close() end

-- 云端实时计费状态
local cloud_pid = nil
if token ~= "" then
	local r = sh("curl -s -m 5 -A 'Mozilla/5.0' -H 'Origin: https://www.leigod.com' -H 'Referer: https://www.leigod.com/' -H 'Content-Type: application/json' --data '{\"account_token\":\"" .. token .. "\"}' 'https://webapi.leigod.com/api/user/info?os_type=4&region_code=1&src_channel=guanwang&lang=zh_CN' | jsonfilter -e '@.data.pause_status_id'")
	r = r:gsub("%s+", "")
	if r ~= "" then cloud_pid = r end
end
local billing_paused = (cloud_pid == "1") or (cloud_pid == nil and gstate == "paused")

local function fmt(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%02d:%02d", math.floor(sec / 60), sec % 60)
end

-- 设备列表
local devs = {}
for ip in (uci_get("devices") or ""):gmatch("%S+") do devs[#devs+1] = ip end

local threshold = idle_min * 60
local max_idle = 0
local rows = {}
for _, ip in ipairs(devs) do
	local lf = io.open("/tmp/leigod-guard/last_seen." .. ip, "r")
	local ls = lf and tonumber(lf:read("*l") or "")
	if lf then lf:close() end
	local laststr, idlestr, leftstr
	if ls then
		local idle = os.time() - ls
		if idle < 0 then idle = 0 end
		if idle > max_idle then max_idle = idle end
		laststr = os.date("%H:%M:%S", ls)
		idlestr = fmt(idle)
		local left = threshold - idle
		leftstr = (left > 0) and fmt(left) or "已达阈值"
	else
		laststr, idlestr, leftstr = "-", "-", "-"
	end
	rows[#rows+1] = { ip, laststr, idlestr, leftstr }
end
local remaining = math.max(0, threshold - max_idle)
local pct = math.min(100, math.floor(max_idle * 100 / threshold))

-- 计时状态判定
local sd_txt, sd_bad
if not alive then
	sd_txt, sd_bad = "守护未运行", true
elseif billing_paused then
	sd_txt, sd_bad = "暂停计费", true
elseif cloud_pid == "0" then
	if gstate == "active" then sd_txt, sd_bad = "设备活动中", false
	elseif gstate == "counting" then sd_txt, sd_bad = "空闲计时中", false
	else sd_txt, sd_bad = "计费中", false end
elseif gstate == "active" then
	sd_txt, sd_bad = "设备活动中", false
elseif gstate == "counting" then
	sd_txt, sd_bad = "空闲计时中", false
else
	sd_txt, sd_bad = "等待数据", true
end

-- 日志
local loglines = {}
local lf = io.open("/tmp/leigod-guard/guard.log", "r")
if lf then
	local all = {}
	for line in lf:lines() do all[#all+1] = line end
	lf:close()
	local start = #all > 10 and (#all - 9) or 1
	for i = start, #all do
		local line = all[i]
		local cls = ""
		if line:match("已自动暂停") or line:match("自动恢复") then cls = "ok"
		elseif line:match("失败") or line:match("失效") or line:match("异常") or line:match("未运行") then cls = "err" end
		loglines[#loglines+1] = '<span class="t">' .. esc(line:sub(1, 17)) .. '</span><span class="' .. cls .. '">' .. esc(line:sub(18) or "") .. "</span>"
	end
end

-- ===== HTML 输出 =====
local H = {}
H[#H+1] = [==[<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>雷神加速器 · 运行状态</title>
<style>
